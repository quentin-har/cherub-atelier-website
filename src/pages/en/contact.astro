---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<BaseLayout
  title="Cherub Atelier — Contact"
  description="Contact Cherub Atelier with any question or custom order for handmade pottery, stained glass or wire sculpture."
  lang="en"
>
  <section class="section">
    <div class="wrap form-wrap center">
      <p class="eyebrow">Contact</p>
      <h1>Write to Cherub Atelier</h1>
      <p class="sub">
        A question, an idea for a custom order&nbsp;?<br>
        Leave a message, I'll be happy to reply.
      </p>
      <ContactForm lang="en" />
    </div>
  </section>
</BaseLayout>

<style>
  .form-wrap { max-width: 560px; margin: 0 auto; }
  h1 { font-size: clamp(1.9rem, 4.4vw, 2.7rem); margin: 0.4rem 0; }
  .sub { opacity: 0.84; margin-top: 0.5rem; font-size: 0.95rem; }
</style>
