---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkCard from '../../components/ArtworkCard.astro';
import GalleryFilters from '../../components/GalleryFilters.astro';
import { sanityClient } from '../../lib/sanity';
import { allArtworksQuery } from '../../lib/queries';

interface Artwork {
  _id: string;
  title_fr: string;
  title_en?: string;
  slug?: string;
  slug_en?: string;
  category: 'pottery' | 'stained-glass' | 'wire-sculpture';
  description_fr?: string;
  description_en?: string;
  imageUrl?: string;
  price_indication?: string;
  status?: 'available' | 'display_only' | 'sold';
}

const titleOf = (a: Artwork) => a.title_en?.trim() || a.title_fr;
const descriptionOf = (a: Artwork) => a.description_en?.trim() || undefined;
// English-specific slug, falling back to the French slug then the raw
// Sanity _id — same fallback chain as the title/description above.
const hrefOf = (a: Artwork) => `/en/gallery/${a.slug_en ?? a.slug ?? a._id}`;

let artworks: Artwork[] = [];
try {
  artworks = await sanityClient.fetch(allArtworksQuery);
} catch {
  // Sanity not configured yet — Phase 4 will resolve this
}
---

<BaseLayout
  title="Cherub Atelier — Gallery"
  description="Gallery of Cherub Atelier's handmade creations: pottery, stained glass and wire sculpture, available for purchase or on display."
  lang="en"
>
  <section class="section wrap">

    <div class="ghead center">
      <p class="eyebrow">The Gallery</p>
      <h1>Available creations</h1>
      <p class="sub">
        For pricing or to reserve a piece, write to me via the&nbsp;
        <a href="/en/contact">Contact</a> page.
      </p>
    </div>

    {artworks.length > 0 ? (
      <GalleryFilters lang="en">
        {artworks.map(artwork => (
          <ArtworkCard
            title={titleOf(artwork)}
            category={artwork.category}
            description={descriptionOf(artwork)}
            imageUrl={artwork.imageUrl}
            status={artwork.status}
            price={artwork.price_indication}
            href={hrefOf(artwork)}
            lang="en"
          />
        ))}
      </GalleryFilters>
    ) : (
      <div class="empty-state">
        <p>Creations are coming soon — check back with us&nbsp;!</p>
        <a class="btn" href="/en/contact">Contact me</a>
      </div>
    )}

  </section>
</BaseLayout>

<style>
  .ghead { margin-bottom: 0.5rem; }
  h1 { font-size: clamp(1.9rem, 4.4vw, 2.7rem); margin: 0.4rem 0; }
  .sub { opacity: 0.8; margin-top: 0.5rem; font-size: 0.95rem; }
  .sub a { color: var(--accent); font-weight: 600; }

  .empty-state { text-align: center; padding: 4rem 1rem; opacity: 0.7; }
</style>
