---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Cherub Atelier — Thank you" lang="en">
  <section class="section">
    <div class="wrap form-wrap center">
      <p class="eyebrow">Contact</p>
      <h1>Thank you for your message!</h1>
      <p class="sub">
        Your message has been sent. I'll get back to you as soon as possible.
      </p>
      <a class="btn" href="/en/gallery">View the gallery</a>
      <a class="btn ghost" href="/en/">Back to home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .form-wrap { max-width: 560px; margin: 0 auto; }
  h1 { font-size: clamp(1.9rem, 4.4vw, 2.7rem); margin: 0.4rem 0; }
  .sub { opacity: 0.84; margin-top: 0.5rem; margin-bottom: 1.6rem; font-size: 0.95rem; }
  .form-wrap .btn { margin: 0 0.4rem; }
</style>
