---
// Legal notice — English mirror of fr/mentions-legales.astro (see that
// file's comment for the full Phase 8-H rationale: mum publishes as a
// non-professional individual under LCEN article 6-III, so the publisher
// name is fetched from Sanity rather than hardcoded, keeping it out of
// this public repo's git history).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { legalNoticeQuery } from '../../lib/queries';

interface LegalNotice {
  directorName?: string;
}

let legal: LegalNotice | null = null;
try {
  legal = await sanityClient.fetch(legalNoticeQuery);
} catch {
  // Sanity not configured yet, or document doesn't exist — fall back below.
}

const directorName = legal?.directorName?.trim();
---

<BaseLayout
  title="Cherub Atelier — Legal notice"
  description="Legal notice for the Cherub Atelier website."
  lang="en"
>
  <section class="section">
    <div class="wrap content">
      <h1>Legal notice</h1>

      <h2>Site publisher</h2>
      {directorName ? (
        <p>
          This site is published on a personal, non-commercial basis by {directorName}.<br>
          In accordance with Article 6-III of French law n° 2004-575 of 21 June 2004 on
          confidence in the digital economy (LCEN), a non-professional publisher's full
          contact details are not made public: they have been provided to the hosting
          provider below and remain available to it upon request from the competent
          judicial authorities.
        </p>
      ) : (
        <p>
          This site is published on a personal, non-commercial basis.<br>
          Full details will be added shortly.
        </p>
      )}

      <h2>Hosting</h2>
      <p>
        This site is hosted by <strong>Netlify, Inc.</strong><br>
        44 Montgomery Street, Suite 300<br>
        San Francisco, CA 94104, United States<br>
        <a href="https://www.netlify.com" rel="noreferrer noopener" target="_blank">netlify.com</a>
      </p>

      <h2>Personal data</h2>
      <p>
        The only place on this site that collects personal data is the form on the
        <a href="/en/contact">Contact page</a>. Filling it in sends your name, email
        address and the content of your message.
      </p>
      <p>
        This information is used only to reply to your inquiry (for example, a question
        about a piece or an order). It is never sold, passed on to a third party, or
        used for marketing purposes, and is kept only for as long as needed to handle
        your request.
      </p>
      <p>
        The form is processed by <strong>Netlify Forms</strong>, the hosting provider
        mentioned above, which acts as a data processor under the GDPR. The data
        therefore passes through its servers, located in the United States; Netlify
        relies on the European Commission's standard contractual clauses to cover this
        transfer.
      </p>
      <p>
        This site sets no cookies and uses no analytics or advertising tracking tools.
      </p>
      <p>
        Under the GDPR, you have the right to access, correct or delete your personal
        data: simply make a request via the <a href="/en/contact">Contact page</a>. You
        may also lodge a complaint with the
        <a href="https://www.cnil.fr" rel="noreferrer noopener" target="_blank">CNIL</a>
        (the French data protection authority) if you believe your rights are not being
        respected.
      </p>

      <h2>Intellectual property</h2>
      <p>
        All creations (pottery, stained glass, wire sculptures) shown on this site are the
        exclusive property of their creator. Any reproduction, even partial, is prohibited
        without express permission.
      </p>

      <h2>Contact</h2>
      <p>
        For any inquiry, please use the <a href="/en/contact">Contact page</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .content { max-width: 720px; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.5rem); margin-bottom: 2rem; }
  h2 { font-size: 1.25rem; margin: 1.8rem 0 0.5rem; color: var(--accent); }
  p  { font-size: 0.95rem; opacity: 0.85; line-height: 1.7; }
  a  { color: var(--accent); font-weight: 600; }
</style>
