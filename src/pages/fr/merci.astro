---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Cherub Atelier — Merci" lang="fr">
  <section class="section">
    <div class="wrap form-wrap center">
      <p class="eyebrow">Contact</p>
      <h1>Merci pour votre message&nbsp;!</h1>
      <p class="sub">
        Votre message a bien été envoyé. Je vous répondrai dès que possible.
      </p>
      <a class="btn" href="/fr/galerie">Voir la galerie</a>
      <a class="btn ghost" href="/fr/">Retour à l'accueil</a>
    </div>
  </section>
</BaseLayout>

<style>
  .form-wrap { max-width: 560px; margin: 0 auto; }
  h1 { font-size: clamp(1.9rem, 4.4vw, 2.7rem); margin: 0.4rem 0; }
  .sub { opacity: 0.84; margin-top: 0.5rem; margin-bottom: 1.6rem; font-size: 0.95rem; }
  .form-wrap .btn { margin: 0 0.4rem; }
</style>
