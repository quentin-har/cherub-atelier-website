---
// À propos — content now lives in Sanity as a singleton document (fixed
// id 'aboutPage', see studio/schemaTypes/aboutPage.ts) so mum can edit her
// own bio in Studio. Falls back to the original generic placeholder if the
// document doesn't exist yet or Sanity isn't configured, so the page never
// breaks.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sanityClient } from '../../lib/sanity';
import { aboutPageQuery } from '../../lib/queries';

interface AboutPage {
  bio_fr?: string;
  bio_en?: string;
  photoUrl?: string;
}

const FALLBACK_BIO =
  "Je suis une artisane passionnée, attachée au travail fait main sous toutes ses formes : " +
  "la céramique, le vitrail et la sculpture sur fil de fer. Chaque pièce naît d'un geste " +
  "patient, pensée et façonnée avec soin, une matière à la fois.";

let about: AboutPage | null = null;
try {
  about = await sanityClient.fetch(aboutPageQuery);
} catch {
  // Sanity not configured yet, or document doesn't exist — fall back below.
}

const bio = about?.bio_fr?.trim() || FALLBACK_BIO;
const showComingSoonNote = !about?.bio_fr?.trim();
---

<BaseLayout
  title="Cherub Atelier — À propos"
  description="Découvrez l'atelier derrière Cherub Atelier : céramique, vitrail et sculpture sur fil de fer, fait main."
  lang="fr"
>
  <section class="section">
    <div class="wrap content center">
      <p class="eyebrow">À propos</p>
      <h1>Mon atelier</h1>
      {about?.photoUrl && (
        <img class="portrait" src={about.photoUrl} alt="" loading="lazy" />
      )}
      <p class="lead" set:text={bio} />
      {showComingSoonNote && (
        <p class="note">
          Cette page est encore en construction — mon parcours et l'histoire de
          l'atelier arrivent très prochainement. Merci de votre visite&nbsp;!
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .content { max-width: 640px; margin: 0 auto; }
  h1 { font-size: clamp(1.9rem, 4.4vw, 2.7rem); margin: 0.4rem 0 1.4rem; }
  .portrait {
    width: 220px;
    height: 220px;
    object-fit: cover;
    border-radius: var(--radius);
    margin: 0 auto 1.6rem;
  }
  .lead { font-size: 1.05rem; opacity: 0.88; line-height: 1.75; white-space: pre-line; }
  .note {
    margin-top: 2rem;
    font-size: 0.88rem;
    opacity: 0.65;
    font-style: italic;
  }
</style>
