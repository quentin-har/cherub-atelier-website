---
// Netlify Forms contact form
// Security features:
//   - data-netlify="true"        → Netlify processes submissions server-side
//   - data-netlify-honeypot      → hidden field; bots fill it, real users don't
//   - form-name hidden input     → required for static site Netlify forms detection
//   - required fields            → browser-side validation before submission
// No server-side code, no database — submissions go straight to Netlify.
//
// action={`/${lang}/merci`} (Phase 8-C fix, extended in Phase 8-F for the
// English route): without this, Netlify serves its own generic, unstyled
// default success page after submission — it has no access to this site's
// CSS at all, which is what looked broken/unstyled to a visitor. Pointing
// action at a real page in this site (src/pages/fr/merci.astro or
// src/pages/en/merci.astro, both wrapped in the normal BaseLayout) makes
// the confirmation page match the rest of the site instead.
//
// lang (Phase 8-F): this form is shared between the French and English
// contact pages, so every visible string branches on it instead of being
// hardcoded to French like the rest of the component used to be.
interface Props {
  lang?: 'fr' | 'en';
}
const { lang = 'fr' } = Astro.props;

const copy = lang === 'fr'
  ? {
      honeypotLabel: 'Ne pas remplir ce champ : ',
      name: 'Nom',
      namePlaceholder: 'Votre nom',
      email: 'Email',
      emailPlaceholder: 'vous@exemple.fr',
      message: 'Message',
      messagePlaceholder: 'Votre message…',
      submit: 'Envoyer',
      privacyNote: 'En envoyant ce formulaire, vous acceptez que ces informations soient utilisées pour vous répondre.',
      privacyLinkText: 'En savoir plus',
    }
  : {
      honeypotLabel: 'Do not fill in this field: ',
      name: 'Name',
      namePlaceholder: 'Your name',
      email: 'Email',
      emailPlaceholder: 'you@example.com',
      message: 'Message',
      messagePlaceholder: 'Your message…',
      submit: 'Send',
      privacyNote: 'By submitting this form, you agree that this information will be used to reply to you.',
      privacyLinkText: 'Learn more',
    };
---

<form
  name="contact"
  method="POST"
  action={`/${lang}/merci`}
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  class="contact-form"
>
  <!-- Honeypot: hidden from real users via CSS; bots fill it and get rejected -->
  <p class="hidden-field">
    <label>{copy.honeypotLabel}<input name="bot-field" /></label>
  </p>

  <!-- Required by Netlify to identify the form in static output -->
  <input type="hidden" name="form-name" value="contact" />

  <div class="field">
    <label for="cf-name">{copy.name} <span aria-hidden="true">*</span></label>
    <input
      type="text"
      id="cf-name"
      name="name"
      required
      autocomplete="name"
      placeholder={copy.namePlaceholder}
    />
  </div>

  <div class="field">
    <label for="cf-email">{copy.email} <span aria-hidden="true">*</span></label>
    <input
      type="email"
      id="cf-email"
      name="email"
      required
      autocomplete="email"
      placeholder={copy.emailPlaceholder}
    />
  </div>

  <div class="field">
    <label for="cf-message">{copy.message} <span aria-hidden="true">*</span></label>
    <textarea
      id="cf-message"
      name="message"
      required
      rows="6"
      placeholder={copy.messagePlaceholder}
    ></textarea>
  </div>

  <p class="privacy-note">
    {copy.privacyNote}
    {' '}<a href={`/${lang}/mentions-legales`}>{copy.privacyLinkText}</a>
  </p>

  <button type="submit" class="btn submit-btn">{copy.submit}</button>
</form>

<style>
  /* Honeypot: visually hidden but not display:none (some bots ignore display:none) */
  .hidden-field {
    position: absolute;
    left: -9999px;
    top: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .contact-form {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: left;
    margin-top: 1.6rem;
  }

  .field { margin-bottom: 1.1rem; }

  label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  input, textarea {
    width: 100%;
    font-family: var(--fbody);
    font-size: 1rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--text);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  input:focus, textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(184, 92, 56, 0.12);
  }
  textarea { resize: vertical; min-height: 130px; }

  .privacy-note {
    font-size: 0.78rem;
    opacity: 0.7;
    line-height: 1.5;
    margin: 0 0 1rem;
  }
  .privacy-note a { color: var(--accent); font-weight: 600; }

  .submit-btn { width: 100%; margin-top: 0.4rem; }
</style>
