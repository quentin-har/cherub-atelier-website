---
// ArtworkCard — used in both gallery and homepage preview
// When imageUrl is provided: shows a real photo from Sanity CDN.
// When not provided: shows a colour-tinted placeholder (category-based).
//
// lang (Phase 8-F): category and status badges used to be hardcoded French
// text baked into this component, even though the title/description text
// itself was always passed in already-translated by the calling page. Now
// both label sets branch on lang so the English gallery/homepage show
// English badges without duplicating this component.

type Category = 'pottery' | 'stained-glass' | 'wire-sculpture';
type Status = 'available' | 'display_only' | 'sold';

interface Props {
  title: string;
  category: Category;
  description?: string;
  imageUrl?: string;
  imageAlt?: string;
  price?: string;
  href?: string;
  status?: Status;
  lang?: 'fr' | 'en';
}

const {
  title,
  category,
  description,
  imageUrl,
  imageAlt = title,
  price,
  href = '#',
  status,
  lang = 'fr',
} = Astro.props;

// No badge for the normal "available" case — only flag the two statuses
// that change what a visitor should expect (can't buy it / already gone).
const statusLabelsByLang: Record<'fr' | 'en', Partial<Record<Status, string>>> = {
  fr: {
    display_only: 'Exposition uniquement',
    sold: 'Déjà vendue',
  },
  en: {
    display_only: 'Display only',
    sold: 'Already sold',
  },
};
const statusLabel = status ? statusLabelsByLang[lang][status] : undefined;

const categoryLabelsByLang: Record<'fr' | 'en', Record<Category, string>> = {
  fr: {
    pottery:         'Céramique',
    'stained-glass': 'Vitrail',
    'wire-sculpture':'Fil de Fer',
  },
  en: {
    pottery:         'Pottery',
    'stained-glass': 'Stained Glass',
    'wire-sculpture':'Wire Sculpture',
  },
};
const categoryLabels = categoryLabelsByLang[lang];

// Sanity CDN image URL with width + auto WebP conversion
const srcUrl = imageUrl ? `${imageUrl}?w=600&h=450&fit=crop&auto=format` : null;
---

<article class="card" data-cat={category}>
  {srcUrl ? (
    <a href={href} class="art-link" tabindex="-1" aria-hidden="true">
      <div class="art-photo">
        <img src={srcUrl} alt={imageAlt} loading="lazy" decoding="async" width="600" height="450" />
      </div>
    </a>
  ) : (
    <div class={`art-placeholder art-${category}`}></div>
  )}
  <div class="cb">
    <span class="badge">{categoryLabels[category]}</span>
    {statusLabel && <span class="badge status">{statusLabel}</span>}
    <h3><a href={href}>{title}</a></h3>
    {description && <p>{description}</p>}
    {price && <div class="cprice">{price}</div>}
  </div>
</article>

<style>
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow  0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .card:hover {
    transform: translateY(-10px) rotate(-1.2deg);
    box-shadow: 0 24px 46px rgba(143, 87, 52, 0.28);
  }

  /* Real photo */
  .art-link  { display: block; }
  .art-photo { aspect-ratio: 4/3; overflow: hidden; }
  .art-photo img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .card:hover .art-photo img { transform: scale(1.05); }

  /* Category placeholder */
  .art-placeholder        { aspect-ratio: 4/3; }
  .art-pottery            { background: linear-gradient(140deg, #fde0c8, #f5cba8); }
  .art-stained-glass      { background: linear-gradient(140deg, #d4eaf8, #b8d8f0); }
  .art-wire-sculpture     { background: linear-gradient(140deg, #e8e8f0, #d8d8e8); }

  /* Card body */
  .cb  { padding: 1rem 1.15rem 1.3rem; }
  .badge.status { background: var(--border); color: var(--text); margin-left: 0.4rem; }
  h3   { font-size: 1.15rem; margin-bottom: 0.3rem; }
  h3 a { color: inherit; }
  h3 a:hover { color: var(--accent); }
  p    { font-size: 0.85rem; opacity: 0.8; margin-top: 0.2rem; }
  .cprice { font-size: 0.82rem; font-weight: 600; opacity: 0.6; margin-top: 0.5rem; }
</style>
