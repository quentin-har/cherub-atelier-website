---
interface Props {
  lang: string;
  // Equivalent URL of the current page in the other language -- always
  // supplied by BaseLayout.astro (computed automatically for most pages,
  // or passed through from the page itself for an artwork detail page,
  // where the slug differs per language). See src/lib/i18n.ts.
  altHref: string;
}

const { lang, altHref } = Astro.props;
const otherLang = lang === 'fr' ? 'en' : 'fr';
const toggleLabel = otherLang === 'fr' ? 'FR' : 'EN';
const toggleAriaLabel = otherLang === 'fr' ? 'Voir en français' : 'View in English';

const base = `/${lang}`;

const links =
  lang === 'fr'
    ? [
        { href: `${base}/`,          label: 'Accueil' },
        { href: `${base}/galerie`,   label: 'Galerie' },
        { href: `${base}/a-propos`, label: 'À propos' },
        { href: `${base}/contact`,   label: 'Contact' },
      ]
    : [
        { href: `${base}/`,        label: 'Home' },
        { href: `${base}/gallery`, label: 'Gallery' },
        { href: `${base}/about`,   label: 'About' },
        { href: `${base}/contact`, label: 'Contact' },
      ];

const path = Astro.url.pathname;
// Mark a link active if the current path starts with its href
const isActive = (href: string) =>
  href === `${base}/` ? path === href : path.startsWith(href);
---

<header class="site-header">
  <a
    class="lang-toggle"
    href={altHref}
    hreflang={otherLang}
    lang={otherLang}
    aria-label={toggleAriaLabel}
  >
    {toggleLabel}
  </a>
  <div class="brand-row">
    <a href={`${base}/`} class="brand">Cherub Atelier<span class="dot">.</span></a>
  </div>
  <nav class="tabs" aria-label="Navigation principale">
    {links.map(link => (
      <a
        href={link.href}
        class:list={['tab', { active: isActive(link.href) }]}
        aria-current={isActive(link.href) ? 'page' : undefined}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    padding: 1.6rem 1rem 1.2rem;
    background: radial-gradient(circle at 50% -20%, #f4dcc2, var(--bg) 70%);
  }
  .lang-toggle {
    position: absolute;
    top: 1.1rem;
    right: 1rem;
    font-family: var(--fhead);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    opacity: 0.75;
    transition: opacity 0.2s, background 0.2s;
  }
  .lang-toggle:hover { opacity: 1; background: var(--soft); }
  .brand {
    font-family: var(--fhead);
    font-size: 1.7rem;
    letter-spacing: 0.02em;
  }
  .dot { color: var(--accent); }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
  }
  .tab {
    display: block;
    font-family: var(--fhead);
    font-weight: 600;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    opacity: 0.6;
    white-space: nowrap;
    transition: opacity 0.2s, background 0.2s;
  }
  .tab:hover { opacity: 1; background: var(--soft); }
  .tab.active { opacity: 1; background: var(--accent); color: #fff; }
</style>
